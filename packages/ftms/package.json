{
  "name": "@open-trainer/ftms",
  "version": "0.2.0",
  "description": "A transport-independent Bluetooth FTMS controller for browser-based smart trainer applications.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cemergin/open-trainer-ftms.git",
    "directory": "packages/ftms"
  },
  "homepage": "https://github.com/cemergin/open-trainer-ftms/tree/main/packages/ftms#readme",
  "bugs": {
    "url": "https://github.com/cemergin/open-trainer-ftms/issues"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-bluetooth": {
      "types": "./dist/web-bluetooth.d.ts",
      "import": "./dist/web-bluetooth.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./transport": {
      "types": "./dist/transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    },
    "./sensors": {
      "types": "./dist/sensors.d.ts",
      "import": "./dist/sensors.js"
    }
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "typecheck:consumer": "node ../../node_modules/@typescript/native/bin/tsc -p test-consumer/tsconfig.json && node ../../node_modules/@typescript/native/bin/tsc -p test-consumer/tsconfig.bundler.json",
    "verify": "npm run typecheck && npm run test && npm run build && npm run typecheck:consumer",
    "prepack": "npm run verify"
  },
  "keywords": [
    "bluetooth",
    "ble",
    "ftms",
    "fitness-machine-service",
    "cycling",
    "indoor-cycling",
    "smart-trainer",
    "erg",
    "kickr",
    "web-bluetooth"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/web-bluetooth": "^0.0.21"
  }
}
