{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cemergin/open-trainer-ftms/hardware/compatibility.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "validatedDevices"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "validatedDevices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["manufacturer", "model", "firmware", "resistanceControlFormat", "report"],
        "properties": {
          "manufacturer": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "firmware": { "type": "string", "minLength": 1 },
          "resistanceControlFormat": { "enum": ["sint16", "uint8"] },
          "report": { "type": "string", "pattern": "^hardware/reports/.+\\.json$" }
        }
      }
    }
  }
}
