{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cemergin/open-trainer-ftms/hardware/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordedAt",
    "packageVersion",
    "hardware",
    "client",
    "checks",
    "passed"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "firmware", "resistanceControlFormat"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "firmware": { "type": "string", "minLength": 1 },
        "resistanceControlFormat": { "enum": ["sint16", "uint8"] }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "browser", "browserVersion"],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "passed": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
