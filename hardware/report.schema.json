{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cemergin/open-trainer-ftms/hardware/report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordedAt",
    "packageVersion",
    "sourceCommit",
    "runtimeFingerprint",
    "hardware",
    "client",
    "testSession",
    "checks",
    "passed"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "packageVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runtimeFingerprint": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "model", "firmware", "resistanceControlFormat"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "firmware": { "type": "string", "minLength": 1 },
        "resistanceControlFormat": { "enum": ["sint16", "uint8"] }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "browser", "browserVersion", "secureContext"],
      "properties": {
        "operatingSystem": { "type": "string", "minLength": 1 },
        "browser": { "type": "string", "minLength": 1 },
        "browserVersion": { "type": "string", "minLength": 1 },
        "secureContext": { "type": "boolean" }
      }
    },
    "testSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "startedAt",
        "realConnectionCount",
        "telemetrySamples",
        "controlResponses",
        "errorCount"
      ],
      "properties": {
        "source": { "const": "trainer-lab" },
        "startedAt": { "type": "string", "format": "date-time" },
        "realConnectionCount": { "type": "integer", "minimum": 0 },
        "telemetrySamples": { "type": "integer", "minimum": 0 },
        "controlResponses": { "type": "integer", "minimum": 0 },
        "errorCount": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "passed", "notes"],
        "properties": {
          "id": {
            "enum": [
              "connect-reconnect-10",
              "telemetry-power-cadence",
              "acquire-control",
              "erg-low-medium-high",
              "resistance-control",
              "simulation-grade",
              "pause-resume",
              "stop",
              "control-loss",
              "competing-app",
              "power-cycle",
              "stop-after-command-traffic"
            ]
          },
          "passed": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "passed": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
